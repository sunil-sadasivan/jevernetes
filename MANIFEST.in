include README.md VALIDATION.md
include examples/mixed.log
prune .runs
prune reports
prune build
prune dist
prune .venv
prune .kube
global-exclude __pycache__ *.py[cod] .DS_Store .env .env.* *.pem *.key kubeconfig kubeconfig.*
global-exclude .review-rules.json
include LICENSE SECURITY.md CONTRIBUTING.md
recursive-include tests *.py *.cjs *.json
recursive-include jevernetes *.py
include SECURITY_REVIEW.md .gitattributes .gitignore
include tools/check_release.py tools/check_python_package.py tools/record-cli-demo.py tools/record-terminal-search.py
recursive-include .github *.yml
include requirements-dev.txt
prune .security-venv
include docs/usage.md

prune target
include docs/legacy-usage.md docs/legacy-dashboard.md docs/migration.md docs/migration-base.md docs/architecture.md

prune .cache
prune bin

# The companion archive ships its active suites; Go/Rust suites are in the full source archive.
exclude tests/test_dashboard_ui.cjs tests/parity.json tests/test_ci_parity.py
prune tests/rust
